# =============================================================================
#  Safety Music Bot — bot settings (bot.env)
#
#  cp bot.env.example bot.env   and fill in the REQUIRED block. Never commit bot.env.
#  Everything below REQUIRED is optional; the value shown is the default.
#
#  Infrastructure secrets (Mongo passwords, NodeLink password, YouTube token,
#  provider keys) do NOT go here: they live in .env (see .env.example) and the bot
#  container never receives them. docker-compose injects only MONGODB_URI,
#  MONGODB_DB, NODELINK_BASE_URL and NODELINK_PASSWORD.
# =============================================================================


# ----------------------------------------------------------------------------
#  REQUIRED
# ----------------------------------------------------------------------------

# Bot token from your Fluxer instance.
BOT_TOKEN=

# Self-hosted Fluxer: point these at your instance.
API_BASE=https://api.fluxer.app/v1
GATEWAY_URL=wss://gateway.fluxer.app


# ----------------------------------------------------------------------------
#  Fluxer connection
# ----------------------------------------------------------------------------

# Ask the API for the gateway URL instead of using GATEWAY_URL as is.
AUTO_GATEWAY_URL=1
# CDN for avatars/attachments in embeds (empty = derived from the API).
FLUXER_CDN_BASE=
GATEWAY_INTENTS=0
# Rotating "N guilds tuned in" status.
GATEWAY_PRESENCE_ENABLED=0
GATEWAY_ONLY_MODE=0
# Exit at startup if the REST API check fails.
STRICT_STARTUP_CHECK=0
API_CHECK_RETRIES=5
API_CHECK_DELAY_MS=1000
REST_TIMEOUT_MS=10000
REST_MAX_RETRIES=4
REST_RETRY_BASE_DELAY_MS=300
# ipv4first | verbatim
DNS_RESULT_ORDER=ipv4first

# Sharding (only for very large bots; each shard is a separate container).
SHARD_ID=0
SHARD_COUNT=1


# ----------------------------------------------------------------------------
#  NodeLink (client side; URL and password come from docker-compose)
# ----------------------------------------------------------------------------

# Search identifier for plain text queries ("search" = NodeLink unified search).
NODELINK_DEFAULT_SEARCH=search
# Sources tried when a track fails to start (first match wins).
NODELINK_MIRROR_SEARCH_ORDER=dzsearch,tdsearch,scsearch,ytsearch,ytmsearch
NODELINK_REQUEST_TIMEOUT_MS=15000
# Timeout for resolving links (playlists can be slow).
NODELINK_LINK_TIMEOUT_MS=30000
NODELINK_STREAM_START_TIMEOUT_MS=10000


# ----------------------------------------------------------------------------
#  MongoDB client (URI comes from docker-compose)
# ----------------------------------------------------------------------------

MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_PING_INTERVAL_MS=15000
GUILD_CONFIG_CACHE_TTL_MS=60000
GUILD_CONFIG_CACHE_MAX_SIZE=5000


# ----------------------------------------------------------------------------
#  Security
# ----------------------------------------------------------------------------

# Keep 0: refuses media URLs that resolve to private/loopback/link-local
# addresses (SSRF guard for radio/direct links, webhooks and cover art).
ALLOW_PRIVATE_MEDIA_URLS=0
# User id allowed to run the owner-only `diag` command. Empty = nobody.
BOT_OWNER_USER_ID=
# Channel id that receives error reports (secrets are redacted). Empty = off.
ERROR_CHANNEL_ID=
# Link shown in help/support. Empty = none.
SUPPORT_URL=

# Command rate limits.
COMMAND_RATE_LIMIT_ENABLED=1
COMMAND_USER_WINDOW_MS=10000
COMMAND_USER_MAX=8
COMMAND_GUILD_WINDOW_MS=10000
COMMAND_GUILD_MAX=40
COMMAND_RATE_LIMIT_BYPASS=help,ping
PLAY_COMMAND_COOLDOWN_MS=2000


# ----------------------------------------------------------------------------
#  Behaviour
# ----------------------------------------------------------------------------

PREFIX=!
# Accept the default prefix even when a guild configured another one.
ALLOW_DEFAULT_PREFIX_FALLBACK=0
# en | de | pt-BR
DEFAULT_LANGUAGE=en
ENABLE_EMBEDS=1
NOW_PLAYING_CARD_ENABLED=1

DEFAULT_VOLUME_PERCENT=100
MIN_VOLUME_PERCENT=0
MAX_VOLUME_PERCENT=200
DEFAULT_DEDUPE_ENABLED=0
# 24/7 mode by default.
DEFAULT_247_ENABLED=0
AUTOPLAY_DEFAULT_ENABLED=0
VOTE_SKIP_RATIO=0.5
VOTE_SKIP_MIN_VOTES=2

MAX_QUEUE_SIZE=100
MAX_PLAYLIST_TRACKS=25
MAX_TRACK_LENGTH_HOURS=6
MAX_SAVED_PLAYLISTS_PER_GUILD=100
MAX_SAVED_TRACKS_PER_PLAYLIST=500
MAX_FAVORITES_PER_USER=500
PERSISTENT_HISTORY_SIZE=200
# Must be <= 10.
SEARCH_RESULT_LIMIT=5
SEARCH_PICK_TIMEOUT_MS=45000

# Leave the voice channel after this long without playback.
SESSION_IDLE_MS=300000
MAX_CONCURRENT_VOICE_CHANNELS_PER_GUILD=5
SESSION_SNAPSHOT_MIN_WRITE_INTERVAL_MS=10000
SESSION_SNAPSHOT_FLUSH_INTERVAL_MS=30000
SESSION_SNAPSHOT_MAX_PENDING_TRACKS=25

VOICE_MAX_BITRATE=192000
VOICE_CONNECT_TIMEOUT_MS=8000


# ----------------------------------------------------------------------------
#  Health, monitoring, diagnostics
# ----------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# /healthz, /readyz, /metrics. Keep on 127.0.0.1 (the container healthcheck uses it).
MONITORING_ENABLED=1
MONITORING_HOST=127.0.0.1
MONITORING_PORT=9091

# Exit (and let Docker restart) when unhealthy for too long.
UNHEALTHY_EXIT_ENABLED=1
UNHEALTHY_EXIT_AFTER_MS=180000
GATEWAY_OUTAGE_EXIT_AFTER_MS=1800000
UNHEALTHY_CHECK_INTERVAL_MS=5000

# Restart when this many leaked audio-capture threads pile up (0 = off).
AUDIO_THREAD_IDLE_RESTART=150
AUDIO_THREAD_RESTART=400

MEMORY_TELEMETRY_INTERVAL_MS=15000
MEMORY_TELEMETRY_LOG_INTERVAL_MS=300000
# Exit when RSS stays above this many MB (0 = off).
MEMORY_RSS_EXIT_MB=0
# SIGUSR2 heap snapshots need a writable dir; off in the read-only container.
HEAP_SNAPSHOT_SIGNAL_ENABLED=0
HEAP_SNAPSHOT_DIR=.heap-snapshots

PLAYBACK_DIAGNOSTICS_ENABLED=0
PLAYBACK_DIAGNOSTICS_INTERVAL_MS=1000

# Path to ffmpeg (the image ships Debian's ffmpeg).
FFMPEG_BIN=/usr/bin/ffmpeg
