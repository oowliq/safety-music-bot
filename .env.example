# =============================================================================
#  Safety Music Bot — infrastructure (.env)
#
#  cp .env.example .env   and fill in the REQUIRED block. Never commit .env.
#  docker-compose reads this file for ${...} substitution only; it is NOT passed
#  into the bot container. Bot settings live in bot.env (see bot.env.example).
#  Generate secrets with:  openssl rand -hex 24
# =============================================================================


# ----------------------------------------------------------------------------
#  REQUIRED
# ----------------------------------------------------------------------------

# Shared by the bot and NodeLink. >=16 chars; well-known defaults
# ("youshallnotpass", "changeme", ...) are rejected at startup.
NODELINK_PASSWORD=

# MongoDB passwords. Letters/digits only: the bot password is embedded into the
# connection URI. Users are created on the first start of an empty volume only;
# changing them later needs a fresh volume (docker compose down -v).
MONGO_ROOT_PASSWORD=
MONGO_BOT_PASSWORD=


# ----------------------------------------------------------------------------
#  Images
# ----------------------------------------------------------------------------

# Image built by GitHub Actions. Leave empty to build locally (docker compose up --build).
# BOT_IMAGE=ghcr.io/<owner>/<repo>:latest

# Pinned in docker-compose.yml; override only on purpose (tag AND digest).
# NODELINK_IMAGE=performanc/nodelink:dev-<sha>@sha256:<digest>
# YT_CIPHER_IMAGE=ghcr.io/kikkia/yt-cipher:master@sha256:<digest>


# ----------------------------------------------------------------------------
#  MongoDB
# ----------------------------------------------------------------------------

MONGODB_DB=fluxer_music_bot
MONGO_ROOT_USER=root
MONGO_BOT_USER=musicbot


# ----------------------------------------------------------------------------
#  NodeLink server
# ----------------------------------------------------------------------------

# debug | info | warn | error
NODELINK_LOGGING_LEVEL=info
NODELINK_SEARCH_MAXRESULTS=10
NODELINK_SEARCH_DEFAULTSOURCE=youtube,soundcloud
NODELINK_SEARCH_UNIFIEDSOURCES=youtube,soundcloud
NODELINK_PLAYBACK_MAXPLAYLISTLENGTH=100

# YouTube "Sign in to confirm you're not a bot": use a TV refresh token of a
# THROWAWAY Google account (never your main one) and/or a proxy. JSON arrays.
NODELINK_SOURCES_YOUTUBE_CLIENTS_SETTINGS_TV_REFRESHTOKEN=[]
NODELINK_SOURCES_YOUTUBE_PROXIES=[]

# Optional Spotify app credentials for Spotify links (NodeLink works anonymously without them).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ----------------------------------------------------------------------------
#  Network
# ----------------------------------------------------------------------------

# Subnet of the `egress` network (bot, NodeLink, yt-cipher). The host firewall
# rules in SECURITY.md use it to block access to your LAN.
EGRESS_SUBNET=172.30.250.0/24
